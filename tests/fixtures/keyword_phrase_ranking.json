  "nodes": {
    "model.pkg.mart__customer_cohort_monthly": {
      "unique_id": "model.pkg.mart__customer_cohort_monthly",
      "name": "mart__customer_cohort_monthly",
      "resource_type": "model",
      "package_name": "pkg",
      "database": "analytics",
      "schema": "marts",
      "alias": "customer_cohort_monthly",
      "raw_code": "select cohort_month, retained_customers, active_customers from customer_cohorts",
      "description": "Monthly customer cohort retention model for analyst questions about retained customers.",
      "columns": {
        "cohort_month": {
          "name": "cohort_month",
          "data_type": "date",
          "description": "Customer signup cohort month.",
          "meta": {
            "nova": {
              "role": "time",
              "semantic_type": "month"
            }
          }
        },
        "customer_segment": {
          "name": "customer_segment",
          "data_type": "string",
          "description": "Customer segment used to slice retention.",
          "meta": {
            "nova": {
              "role": "dimension",
              "semantic_type": "customer_segment"
            }
          }
        },
        "retention_rate": {
          "name": "retention_rate",
          "data_type": "numeric",
          "description": "Monthly retention rate for the cohort.",
          "meta": {
            "nova": {
              "role": "measure",
              "semantic_type": "rate"
            }
          }
        }
      },
      "meta": {
        "owner": "analytics",
        "nova": {
          "canonical": true,
          "synonyms": [
            "customer cohort retention monthly",
            "monthly customer retention",
            "cohort retention"
          ],
          "domains": ["customer", "growth", "subscriptions"],
          "use_cases": [
            "customer cohort retention monthly reporting",
            "retention rate analysis",
            "cohort health review"
          ],
          "grain": {
            "time_field": "cohort_month",
            "dimensions": ["customer_segment"]
          },
          "metrics": [
            {
              "name": "customer_retention_rate",
              "description": "Retention rate for customer cohorts by month.",
              "expression": "retained_customers / nullif(active_customers, 0)",
              "synonyms": ["retention rate", "customer retention rate"],
              "canonical": true
            }
          ],
          "governance": {
            "sensitivity": "internal",
            "pii": false,
            "compliance": ["SOX"]
          }
        }
      }
    },
